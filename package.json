{
  "name": "realtime-clinical-notes-demo",
  "version": "1.0.0",
  "description": "How an AI clinical scribe works: streaming transcript to a structured SOAP note in real time, every item linked to the words it came from, negation-aware, allergy and drug checks, PHI-safe logging and clinician sign-off.",
  "scripts": {
    "demo": "tsx src/demo.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run typecheck && npm test -- --coverage && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndanetaadmire-debug/realtime-clinical-notes-demo.git"
  },
  "author": "Admire T. Ndaneta",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ndanetaadmire-debug/realtime-clinical-notes-demo/issues"
  },
  "homepage": "https://github.com/ndanetaadmire-debug/realtime-clinical-notes-demo#readme",
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
